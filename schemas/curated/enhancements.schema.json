{
  "_comment": "AI-Assisted: Claude Code (model: claude-opus-5) - Authored per curated-snapshot-format.md §2.4 (task T032). detachment_id is REQUIRED: an enhancement whose detachment does not resolve is the blocking CON-ORPHAN-ENHANCEMENT (FR-030). No eligibility rows means the enhancement is offered to any Character in the army — absence is the default, not an omission.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-badgerworks.github.io/wargame-rules-data/schemas/curated/enhancements.schema.json",
  "title": "Curated factions/<faction-id>/enhancements.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["enhancements"],
  "properties": {
    "enhancements": {
      "type": "array",
      "description": "Sorted by enhancement_id.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enhancement_id",
          "detachment_id",
          "name",
          "points",
          "max_per_army",
          "provenance"
        ],
        "properties": {
          "enhancement_id": { "type": "string", "pattern": "^e-[a-z0-9-]+$" },
          "detachment_id": { "type": "string", "pattern": "^d-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "points": { "type": "integer", "minimum": 0 },
          "max_per_army": { "type": "integer", "minimum": 1 },
          "eligibility": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule_type", "value"],
              "properties": {
                "rule_type": {
                  "enum": ["requires_keyword", "forbids_keyword", "datasheet_allowlist"]
                },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          },
          "provenance": { "$ref": "#/$defs/provenance" }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points_source", "points_edition_code", "detail_source", "detail_edition_code"],
      "properties": {
        "points_source": { "enum": ["mfm", "last_known", "none"] },
        "points_acquisition_id": { "type": "string", "minLength": 1 },
        "points_edition_code": { "type": "string", "minLength": 1 },
        "detail_source": { "enum": ["wahapedia", "none"] },
        "detail_acquisition_id": { "type": "string", "minLength": 1 },
        "detail_edition_code": { "type": "string", "minLength": 1 }
      }
    }
  }
}
