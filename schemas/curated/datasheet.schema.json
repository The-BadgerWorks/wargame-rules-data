{
  "_comment": "AI-Assisted: Claude Code (model: claude-opus-5) - Authored per curated-snapshot-format.md §2.5 (task T032). Three things this schema enforces that are easy to lose: (1) ability_keys carries KEYS, never text -- summaries live in curation/abilities/<faction-id>.json and are resolved at build time, which is what keeps authored content out of the machine-written tree entirely; (2) an uncurated optional is OMITTED, never null and never a guess (FR-019, §5), so no property here is nullable; (3) costs[] is copy-indexed -- copy_index_min is the 1-based ordinal of a copy within one army counted across all squad sizes, a copy_index_min = 1 row must exist for every model_count (guarantee 7, PRC-TIER-INCOMPLETE), and model_count values are band LOWER bounds (C2/R5).",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-badgerworks.github.io/wargame-rules-data/schemas/curated/datasheet.schema.json",
  "title": "Curated factions/<faction-id>/datasheets/<datasheet-id>.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasheet_id", "faction_id", "name", "costs", "provenance"],
  "properties": {
    "datasheet_id": { "type": "string", "pattern": "^ds-[a-z0-9-]+$" },
    "faction_id": { "type": "string", "pattern": "^f-[a-z0-9-]+$" },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name. A change here IS a rename (FR-015), never a removal plus an addition."
    },
    "role": { "type": "string", "minLength": 1 },
    "is_legends": { "type": "boolean" },
    "is_character": { "type": "boolean" },
    "is_epic_hero": { "type": "boolean" },
    "is_battleline": { "type": "boolean" },
    "is_dedicated_transport": { "type": "boolean" },
    "max_copies_per_army": {
      "type": "integer",
      "minimum": 1,
      "description": "OMITTED when uncurated -- never guessed. The app then reports the rule as unevaluated rather than enforcing a fabricated one (FR-019)."
    },
    "damaged_threshold": { "type": "integer", "minimum": 0 },
    "models": {
      "type": "array",
      "description": "Sorted by line.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "name",
          "movement",
          "toughness",
          "save",
          "wounds",
          "leadership",
          "objective_control"
        ],
        "properties": {
          "line": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "movement": { "type": "string", "minLength": 1 },
          "toughness": { "type": "integer" },
          "save": { "type": "string", "minLength": 1 },
          "invuln_save": { "type": "string", "minLength": 1 },
          "wounds": { "type": "integer" },
          "leadership": { "type": "string", "minLength": 1 },
          "objective_control": { "type": "integer" },
          "base_size": { "type": "string", "minLength": 1 }
        }
      }
    },
    "weapons": {
      "type": "array",
      "description": "Sorted by line.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "name",
          "is_melee",
          "attacks",
          "skill",
          "strength",
          "armour_penetration",
          "damage"
        ],
        "properties": {
          "line": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "is_melee": { "type": "boolean" },
          "range": { "type": "string", "minLength": 1 },
          "attacks": { "type": "string", "minLength": 1 },
          "skill": { "type": "string", "minLength": 1 },
          "strength": { "type": "string", "minLength": 1 },
          "armour_penetration": { "type": "string", "minLength": 1 },
          "damage": { "type": "string", "minLength": 1 },
          "ability_keywords": {
            "type": "array",
            "description": "Keywords only -- 'lethal hits', 'rapid fire 1'. Never rules text.",
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    },
    "keywords": {
      "type": "array",
      "description": "Sorted by (keyword, model_scope). model_scope is OMITTED when the keyword applies to the whole unit.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyword"],
        "properties": {
          "keyword": { "type": "string", "minLength": 1, "maxLength": 64 },
          "is_faction_keyword": { "type": "boolean" },
          "model_scope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ability_keys": {
      "type": "array",
      "description": "Sorted. Keys, not text.",
      "items": { "type": "string", "pattern": "^(core|faction|datasheet):[A-Za-z0-9:_-]+$" }
    },
    "leader_pairs": {
      "type": "array",
      "description": "Sorted datasheet ids this datasheet may lead.",
      "items": { "type": "string", "pattern": "^ds-[a-z0-9-]+$" }
    },
    "wargear_options": {
      "type": "array",
      "description": "Sorted by id. COST-BEARING options only; points_delta comes from the points source while the structure comes from the detail source (C8/R3). An option whose cost the points source does not publish is the advisory CON-WARGEAR-COST-MISSING, never a zero.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group_key", "name", "points_delta"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "group_key": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "points_delta": { "type": "integer" },
          "max_per_unit": { "type": "integer", "minimum": 1 },
          "models_per_instance": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "costs": {
      "type": "array",
      "minItems": 1,
      "description": "Sorted by (copy_index_min, model_count). At least one row is required; none is the blocking CON-NO-COST (FR-030). source_acquisition_id is CURATED-ONLY.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_count", "copy_index_min", "points", "label", "pricing_confidence"],
        "properties": {
          "model_count": { "type": "integer", "minimum": 1 },
          "copy_index_min": { "type": "integer", "minimum": 1 },
          "points": { "type": "integer", "minimum": 0 },
          "label": { "type": "string", "minLength": 1, "maxLength": 64 },
          "pricing_confidence": { "enum": ["verified", "unverified"] },
          "source_acquisition_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pricing_confidence": { "$ref": "#/$defs/pricing_confidence" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "pricing_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "description": "The datasheet-level confidence state and its carry-forward bookkeeping. 'unverified' is advisory -- the unit ships on the best price known, never withheld and never dropped (FR-035). 'unpriced' is the only pricing state that blocks (FR-026).",
      "properties": {
        "state": { "enum": ["verified", "unverified", "unpriced"] },
        "unverified_since_version": { "type": "string", "minLength": 1 },
        "consecutive_unverified_releases": { "type": "integer", "minimum": 0 },
        "last_verified_version": { "type": "string", "minLength": 1 },
        "last_verified_points_digest": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points_source", "points_edition_code", "detail_source", "detail_edition_code"],
      "properties": {
        "points_source": { "enum": ["mfm", "last_known", "none"] },
        "points_acquisition_id": { "type": "string", "minLength": 1 },
        "points_edition_code": { "type": "string", "minLength": 1 },
        "detail_source": { "enum": ["wahapedia", "none"] },
        "detail_acquisition_id": { "type": "string", "minLength": 1 },
        "detail_edition_code": { "type": "string", "minLength": 1 }
      }
    }
  }
}
