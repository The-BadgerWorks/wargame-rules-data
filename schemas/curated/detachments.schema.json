{
  "_comment": "AI-Assisted: Claude Code (model: claude-opus-5) - Authored per curated-snapshot-format.md §2.4 (task T032). force_disposition and is_unique are CURATED-ONLY and are dropped at the bundle boundary (C4/R7): force disposition drives mission play, an explicit 001 non-goal, and the Unique rule is not established from the source, so FR-019 forbids guessing it. restriction_type is the closed vocabulary of reference-db-schema.md §4 at restriction_vocabulary_version 1; anything outside it is the blocking CON-RESTRICTION-VOCAB. message_template is AUTHORED by the producer and carries no publisher wording.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-badgerworks.github.io/wargame-rules-data/schemas/curated/detachments.schema.json",
  "title": "Curated factions/<faction-id>/detachments.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["detachments"],
  "properties": {
    "detachments": {
      "type": "array",
      "description": "Sorted by detachment_id.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["detachment_id", "name", "detachment_points_cost", "is_legends", "provenance"],
        "properties": {
          "detachment_id": { "type": "string", "pattern": "^d-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "detachment_points_cost": { "type": "integer", "minimum": 0 },
          "is_legends": { "type": "boolean" },
          "force_disposition": { "type": "string", "minLength": 1 },
          "is_unique": { "type": "boolean" },
          "restrictions": {
            "type": "array",
            "description": "Sorted by id.",
            "items": { "$ref": "#/$defs/restriction" }
          },
          "provenance": { "$ref": "#/$defs/provenance" }
        }
      }
    }
  },
  "$defs": {
    "restriction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "restriction_type", "params", "message_template"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "restriction_type": {
          "enum": [
            "max_copies_per_datasheet",
            "max_units_with_keyword",
            "min_units_with_keyword",
            "requires_keyword_in_army",
            "forbids_keyword_in_army",
            "forbids_datasheet",
            "legends_allowed",
            "max_enhancements",
            "unique_epic_heroes"
          ]
        },
        "params": { "type": "object" },
        "message_template": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points_source", "points_edition_code", "detail_source", "detail_edition_code"],
      "properties": {
        "points_source": { "enum": ["mfm", "last_known", "none"] },
        "points_acquisition_id": { "type": "string", "minLength": 1 },
        "points_edition_code": { "type": "string", "minLength": 1 },
        "detail_source": { "enum": ["wahapedia", "none"] },
        "detail_acquisition_id": { "type": "string", "minLength": 1 },
        "detail_edition_code": { "type": "string", "minLength": 1 }
      }
    }
  }
}
